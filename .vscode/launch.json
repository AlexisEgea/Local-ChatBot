{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Communication Server",
      "type": "debugpy",
      "request": "launch",
      "python": "${userHome}\\anaconda3\\envs\\Local-ChatBot\\python.exe",
      "program": "${workspaceFolder}/src/communication/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/infra/env",
      "env": {
        "COMMUNICATION_HOST": "127.0.0.1",
        "COMMUNICATION_PORT": "8080",
        "CONDA_DEFAULT_ENV": "Local-ChatBot",
        "CONDA_PREFIX": "${userHome}\\anaconda3\\envs\\Local-ChatBot"
      }
    }
  ]
}
